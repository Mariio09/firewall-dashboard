# =========================================================================== #
# firewall-dashboard — backend
#
# Copiar a `.env` y rellenar.  `.env` NUNCA se versiona (ver .gitignore).
#
# Este archivo esta configurado para el BLOQUE A: todo corre en el Mac, sin VM
# y sin privilegios.  Los valores para la VM van comentados debajo de cada uno.
# =========================================================================== #

# --- Aplicacion ------------------------------------------------------------ #
APP_ENV=dev                          # dev | vm | prod
APP_NAME=firewall-dashboard
LOG_LEVEL=INFO
LOG_FORMAT=console                   # console (dev) | json (VM)

# --- API ------------------------------------------------------------------- #
API_HOST=127.0.0.1                   # en la VM: la IP de la interfaz de Multipass
API_PORT=8000
API_V1_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Base de datos --------------------------------------------------------- #
DATABASE_URL=sqlite:///./firewall.db
# En la VM: sqlite:////var/lib/firewall-dashboard/firewall.db

# --- Autenticacion --------------------------------------------------------- #
# Generar con:  openssl rand -hex 32
# Sin este valor la aplicacion NO debe arrancar.  Fallar en el arranque es
# siempre mejor que fallar en la primera peticion.
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Solo se usan en el primer arranque, para crear el administrador inicial.
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=

# --- Firewall -------------------------------------------------------------- #
# EL INTERRUPTOR.  Con 'fake' el backend guarda las reglas en memoria y todo el
# MVP funciona en el Mac.  Cambiar a 'iptables' es, literalmente, el bloque C.
FIREWALL_BACKEND=fake                # fake | iptables

IPTABLES_BIN=/usr/sbin/iptables
IPTABLES_TABLE=filter
MANAGED_CHAIN_PREFIX=FWDASH          # produce FWDASH_INPUT, FWDASH_OUTPUT, FWDASH_FORWARD
USE_SUDO=true                        # false si se usan capabilities (recomendado, ver ADR-0003)
COMMAND_TIMEOUT_SECONDS=10
AUTO_APPLY=true                      # false = flujo staged tipo terraform plan/apply

# --- Proteccion contra auto-bloqueo ---------------------------------------- #
# Alimentan las REGLAS GUARDIAN que se emiten siempre en cabecera de cada cadena
# gestionada y que ninguna regla de usuario puede desactivar.  Ver ARCHITECTURE §0.
MANAGEMENT_PORT=8000
# OBLIGATORIA con FIREWALL_BACKEND=iptables o APP_ENV=vm|prod: no tiene valor por
# defecto, y es deliberado (ADR-0016).  Es la red DESDE LA QUE se te permite
# administrar, y va dentro de la regla guardian que abre el puerto de gestion: si
# aqui pones una red plausible pero falsa, el guardian abre el puerto a una
# subred donde no estas y te bloqueas con la regla escrita para protegerte.
# CONSULTALA, no la supongas -- el bridge de Multipass no siempre es 192.168.64.0/24:
#   multipass exec firewall-lab -- ip -4 -o addr show scope global
# En la VM la escribe `deploy_vm.sh`, derivada de la interfaz real.
MANAGEMENT_ALLOWED_CIDR=
# OPCIONAL y sin valor por defecto (ADR-0017).  El puerto por el que entras a
# ADMINISTRAR la maquina, que en esta VM es el 22: `multipass` va por SSH y no hay
# canal fuera de banda, asi que un `DROP tcp --dport 22` de usuario te deja fuera
# sin una sola queja (medido en B4).  Si lo declaras, se emite un guardian que lo
# abre DESDE MANAGEMENT_ALLOWED_CIDR; si lo dejas vacio, el 22 se filtra como
# cualquier otro puerto.  Vacio por defecto a proposito: un firewall no trae
# agujeros fijos que nadie ha pedido.
MANAGEMENT_SSH_PORT=
