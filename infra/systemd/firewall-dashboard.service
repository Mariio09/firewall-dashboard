# =========================================================================== #
# firewall-dashboard — unidad systemd (OPCIÓN B del ADR-0003, recomendada)
#
# Instalación:
#   sudo cp infra/systemd/firewall-dashboard.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now firewall-dashboard
#
# Comprobar el endurecimiento:
#   systemd-analyze security firewall-dashboard
# =========================================================================== #

[Unit]
Description=firewall-dashboard — gestion de reglas de iptables
Documentation=file:/home/ubuntu/app/docs/ARCHITECTURE.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=fwdash
Group=fwdash
WorkingDirectory=/home/ubuntu/app/backend
EnvironmentFile=/home/ubuntu/app/backend/.env
ExecStart=/home/ubuntu/app/backend/.venv/bin/uvicorn app.main:app --host ${API_HOST} --port ${API_PORT}
Restart=on-failure
RestartSec=5

# --------------------------------------------------------------------------- #
# Privilegios — el corazon de esta unidad
#
# CAP_NET_ADMIN es EXACTAMENTE lo que iptables necesita. Nada mas.
# El proceso nunca es root y NoNewPrivileges impide que llegue a serlo.
# --------------------------------------------------------------------------- #
AmbientCapabilities=CAP_NET_ADMIN CAP_NET_RAW
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_RAW
NoNewPrivileges=yes

# --------------------------------------------------------------------------- #
# Aislamiento del sistema de archivos
# --------------------------------------------------------------------------- #
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/var/lib/firewall-dashboard
ReadOnlyPaths=/home/ubuntu/app

# --------------------------------------------------------------------------- #
# Aislamiento del kernel
# --------------------------------------------------------------------------- #
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
ProtectClock=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictNamespaces=yes

# Solo las familias de sockets que se necesitan. AF_NETLINK es imprescindible:
# es como iptables habla con el kernel.
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK

SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
SystemCallArchitectures=native

# --------------------------------------------------------------------------- #
# Logs
# --------------------------------------------------------------------------- #
StandardOutput=journal
StandardError=journal
SyslogIdentifier=firewall-dashboard

[Install]
WantedBy=multi-user.target
