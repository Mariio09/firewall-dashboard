# Copiar a `.env`. Nunca se versiona.
#
# Bloque A: el backend corre en el Mac con FIREWALL_BACKEND=fake.
VITE_API_BASE_URL=http://127.0.0.1:8000/api/v1

# Bloque C: apunta al backend de la VM. La IP NO es fija y NO se escribe a mano:
# la red de Multipass cambia entre maquinas y entre versiones (en este Mac es
# 192.168.252.0/24, no el 192.168.64.0/24 que la documentacion daba por hecho).
#
#   make c-front      -> escribe este valor con la IP que tenga la VM ahora
#   make vm-ip        -> solo la consulta
#
# Vite lee el .env AL ARRANCAR: despues de cambiarlo hay que reiniciar el
# servidor de desarrollo, no basta con recargar el navegador.
# VITE_API_BASE_URL=http://<make vm-ip>:8000/api/v1
